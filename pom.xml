<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Parent coordinates -->
    <groupId>com.example.trading</groupId>
    <artifactId>sp500-trading-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>sp500-trading-platform</name>
    <description>SP 500 Trading System using gRPC + GCP</description>

    <!-- Inherit Spring Boot defaults -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- Set Java version -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- Manage shared dependencies here if needed -->
    <dependencyManagement>
        <dependencies>
            <!-- Optional: Pin versions for shared gRPC libraries -->
            <dependency>
                <groupId>net.devh</groupId>
                <artifactId>grpc-spring-boot-starter</artifactId>
                <version>2.15.0.RELEASE</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- List of child modules -->
    <modules>
        <module>protos</module>
        <module>order-service</module>
        <module>matching-engine</module>
        <module>trade-executor-service</module>
        <module>ledger-service</module>
        <module>portfolio-service</module>
    </modules>
</project>
